# sc2k5 rebuild

Options -Indexes
DirectoryIndex index.php index.html

# internals — never web-served
RedirectMatch 404 ^/lib/(.*)$
RedirectMatch 404 ^/templates/(.*)$
RedirectMatch 404 ^/build-notes/(.*)$
RedirectMatch 404 ^/content/(.*)$

<FilesMatch "^\.(gfpw|dbconfig\.php)$">
  Require all denied
</FilesMatch>

<IfModule mod_rewrite.c>
  RewriteEngine On
  RewriteBase /

  # ACME / cPanel DCV challenges — never route to the app, never redirect
  RewriteRule ^\.well-known/ - [L]

  # canonical host: add www, force https, single hop
  RewriteCond %{HTTP_HOST} !^www\. [NC]
  RewriteRule ^ https://www.%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # force HTTPS (cPanel sets HTTPS=on; also honour the proxy header just in case)
  RewriteCond %{HTTPS} !=on
  RewriteCond %{HTTP:X-Forwarded-Proto} !https
  RewriteRule ^ https://%{HTTP_HOST}%{REQUEST_URI} [R=301,L]

  # real files/dirs served directly
  RewriteCond %{REQUEST_FILENAME} -f [OR]
  RewriteCond %{REQUEST_FILENAME} -d
  RewriteRule ^ - [L]

  # everything else -> front controller
  RewriteRule ^ index.php [L]
</IfModule>

# PHP version is set on the vhost (alt-php82) via MultiPHP Manager — no handler line here.

# php -- BEGIN cPanel-generated handler, do not edit
# Set the “alt-php82” package as the default “PHP” programming language.
<IfModule mime_module>
  AddHandler application/x-httpd-alt-php82 .php .php8 .phtml
</IfModule>
# php -- END cPanel-generated handler, do not edit
